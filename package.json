{
  "name": "agent-ally",
  "version": "0.1.4",
  "description": "Accessibility-first control layer for AI coding agents — driven by speech, keyboard, and your phone",
  "license": "MIT",
  "author": "mfmshazan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfmshazan/agent-ally.git"
  },
  "homepage": "https://github.com/mfmshazan/agent-ally#readme",
  "keywords": [
    "accessibility",
    "a11y",
    "claude",
    "claude-code",
    "screen-reader",
    "ai-agent",
    "voice",
    "blind",
    "tts"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "agent-ally": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "spike": "tsx src/spike/probe.ts",
    "spike:q": "tsx src/spike/probe-question.ts",
    "test": "tsx test/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
